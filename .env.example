# GPU Configuration
USE_GPU=true
CUDA_DEVICE=0

# Model Configuration
STAGE1_BACKBONE=efficientnet_b0
STAGE2_BACKBONE=efficientnet_b0
STAGE1_THRESHOLD=0.7
STAGE2_THRESHOLD=0.6

# Training Configuration
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=50
EARLY_STOPPING_PATIENCE=10

# Data Configuration
DATA_DIR=./data
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15

# Logging Configuration
LOG_DIR=./logs
LOG_LEVEL=INFO

# Web Application Configuration
FLASK_ENV=development
FLASK_DEBUG=true
MAX_UPLOAD_SIZE=10485760
